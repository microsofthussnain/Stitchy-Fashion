generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres.gsxbsjzytjoyifztdnna:%40Hussnain2028@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
  directUrl="postgresql://postgres.gsxbsjzytjoyifztdnna:%40Hussnain2028@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"
}

enum UserRole {
  ADMIN
  OWNER
}

enum OrderStatus {
  NEW
  CONFIRMED
  CUTTING
  STITCHING
  READY
  DELIVERED
  CANCELLED
}

enum AdmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MessageType {
  TEXT
  IMAGE
  VOICE
  ORDER
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages     Message[]
  notifications Notification[]
  salaryRecords SalaryRecord[]
}

model Customer {
  id        String   @id @default(cuid())
  fullName  String
  phone     String
  whatsapp  String?
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  messages  Message[]
}

model Order {
  id                   String      @id @default(cuid())
  orderNumber          String      @unique
  customerId           String
  customer             Customer    @relation(fields: [customerId], references: [id])

  numberOfPieces       Int         @default(1)
  specialStyle         String?
  specialRequirements  String?
  deliveryRequirements String?

  status               OrderStatus @default(NEW)
  adminNotes           String?

  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  measurements         Measurement?
  coatTypes            OrderCoat[]
  images               OrderImage[]
  messages             Message[]
}

model Measurement {
  id       String @id @default(cuid())
  orderId  String @unique
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  coatChest          String?
  coatWaist          String?
  coatShoulder       String?
  coatSleeveLength   String?
  coatLength         String?
  coatNeck           String?
  coatBicep          String?
  coatWrist          String?
  coatFrontLength    String?
  coatBackLength     String?
  coatSpecial        String?

  pantWaist          String?
  pantHip            String?
  pantThigh          String?
  pantKnee           String?
  pantBottom         String?
  pantLength         String?
  pantCrotch         String?
  pantSpecial        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoatType {
  id          String @id @default(cuid())
  name        String
  description String
  purpose     String?
  wornWhen    String?
  styleInfo   String?
  images      String[]
  active      Boolean @default(true)

  orders      OrderCoat[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OrderCoat {
  id         String @id @default(cuid())
  orderId    String
  coatTypeId String

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  coatType   CoatType @relation(fields: [coatTypeId], references: [id])
}

model OrderImage {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  url       String
  filename  String
  createdAt DateTime @default(now())
}

model Student {
  id        String   @id @default(cuid())
  fullName  String
  fatherName String?
  phone     String
  whatsapp  String?
  email     String?
  address   String?
  age       Int?
  education String?
  experience String?
  preferredTime String?
  message   String?
  documentUrl String?

  admissions Admission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admission {
  id        String          @id @default(cuid())
  studentId String
  student   Student         @relation(fields: [studentId], references: [id])

  status    AdmissionStatus @default(PENDING)
  adminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id         String      @id @default(cuid())

  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id])

  orderId    String?
  order      Order?      @relation(fields: [orderId], references: [id])

  senderId   String?
  sender     User?       @relation(fields: [senderId], references: [id])

  type       MessageType @default(TEXT)
  text       String?
  mediaUrl   String?

  read       Boolean     @default(false)
  createdAt  DateTime    @default(now())
}

model GalleryItem {
  id          String   @id @default(cuid())
  title       String
  category    String
  description String?
  imageUrl    String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  name      String
  rating    Int
  comment   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SalaryRecord {
  id             String   @id @default(cuid())
  adminId        String
  admin          User     @relation(fields: [adminId], references: [id])

  monthlySalary  Float
  amountReceived Float      @default(0)
  creditAdvance  Float      @default(0)
  notes          String?

  paymentDate    DateTime?
  createdAt      DateTime   @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  title     String
  message   String
  read      Boolean @default(false)

  createdAt DateTime @default(now())
}